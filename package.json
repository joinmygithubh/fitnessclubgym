{
  "name": "fitness-club-gym",
  "version": "1.0.0",
  "description": "Full-Stack Website & Portal for Fitness Club Gym (Modular Monolith)",
  "main": "backend/src/server.js",
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
