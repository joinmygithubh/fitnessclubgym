    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "seed:admin": "cd backend && node scripts/createAdmin.js"
  },
  "keywords": [
    "fitness",
    "gym",
    "mern",
    "react",
    "express",
    "mongodb",
    "vite",
    "tailwind"
  ],
